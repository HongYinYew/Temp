# Copy this file to ".env" and fill in real values.
# The pipeline runs WITHOUT any keys in --mock mode.
# Load it with:  node --env-file=.env src/index.js --week 1

# --- ElevenLabs (voiceover). Needed only for real audio (Phase 1+). ---
ELEVENLABS_API_KEY=
# Default voice id below is "Adam". Swap for your locked brand voice.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Pexels (auto B-roll fetch). Needed only for Phase 2. ---
PEXELS_API_KEY=

# --- Optional LLM (only used to AUTHOR scripts not already in the library). ---
# Leave blank to rely purely on the reusable script library in content/scripts/.
OPENAI_API_KEY=
